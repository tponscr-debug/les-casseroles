{
    "manifest_version": 3,
    "name": "Les Casseroles",
    "version": "3.0",
    "description": "Affiche, sources à l'appui, les affaires judiciaires et polémiques des responsables politiques français sur n'importe quelle page.",
    "icons": {
        "16": "icon_final.png",
        "48": "icon_final.png",
        "128": "icon_final.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icon_final.png",
            "48": "icon_final.png",
            "128": "icon_final.png"
        },
        "default_title": "Les Casseroles"
    },
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://raw.githubusercontent.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "js/text.js",
                "js/matcher.js",
                "js/data.js",
                "js/copy.js",
                "js/context.js",
                "js/ui-render.js",
                "js/ui.js",
                "js/highlighter.js",
                "content.js"
            ],
            "css": [
                "fonts.css",
                "highlight.css"
            ],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "data/encyclopedia.json",
                "icon_final.png",
                "casserole_v3.png",
                "ui.css",
                "fonts/*.woff2"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "default_locale": "fr"
}
